          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"category\" TEXT NULL, \"unit\" TEXT NOT NULL, \"selling_price\" REAL NOT NULL CHECK(\"selling_price\" >= 0.0), \"quantity\" INTEGER NOT NULL CHECK(\"quantity\" >= 0), \"low_stock_threshold\" INTEGER NOT NULL CHECK(\"low_stock_threshold\" >= 0), \"barcode\" TEXT NULL UNIQUE, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
